{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "latest",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "post-content-to-markdown/post-content-to-markdown.php"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/post-content-to-markdown-fixtures.php",
      "data": "<?php\n// Test fixtures for post-content-to-markdown.\n\n// Let tests start from an empty Markdown feed cache.\nadd_action('init', function () {\n    if (isset($_GET['clear_markdown_feed_cache'])) {\n        \\PostContentToMarkdown\\clearFeedCache();\n    }\n});\n"
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once '/wordpress/wp-load.php';\n\n$protected = wp_insert_post([\n    'post_title' => 'Protected Post',\n    'post_name' => 'protected-post',\n    'post_status' => 'publish',\n    'post_password' => 'letmein',\n    'post_content' => '<p>PROTECTED-BODY-7c1e</p>',\n]);\nwp_insert_comment([\n    'comment_post_ID' => $protected,\n    'comment_author' => 'Commenter',\n    'comment_content' => 'PROTECTED-COMMENT-7c1e',\n    'comment_approved' => 1,\n]);\n\nflush_rewrite_rules();\n"
    }
  ]
}
